{# 
    ROLE: Page permettant à l'utilisateur de choisir quel type de compte il souhaite créer
    URL : /choix/inscription (ou route 'app_choix_inscription')
    
#}
{% extends 'base.html.twig' %}

{# TITRE DE LA PAGE - S'affiche dans l'onglet du navigateur #}
{% block title %}Inscription{% endblock %}

{# STYLES CSS SPÉCIFIQUES - Fichier CSS pour cette page uniquement #}
{% block stylesheets %}
{{ parent() }}   {# Garde le CSS global de base.html.twig (on a besoin pour l'en-tete et le footer) #}
<link rel="stylesheet" href="{{ asset('css/choixInscription.css') }}">
{% endblock %}


{# CONTENU PRINCIPAL DE LA PAGE #}
{% block main %}
    <div class="split-screen">

       {# 
            OPTION CLIENT
            UTILISATION : Lien cliquable vers l'inscription client
            QUAND ON CLIQUE : Redirige vers /client/register qui affiche un formulaire
    
       #}
        <a href="{{ path('inscription_client') }}" class="choice-section client-side">
            <i class="fa-solid fa-user-gear"></i>
            <h2>Client</h2>
            <div class="btn-choice">S'inscrire en tant que Client</div>
        </a>


        {#
            OPTION POMPISTE 
            UTILISATION : Lien cliquable vers l'inscription pompiste
            QUAND ON CLIQUE : Redirige vers /register qui affiche un formulaire 
        #}
        <a href="{{ path('inscription_pompiste') }}" class="choice-section pompiste-side">
            <i class="fa-solid fa-gas-pump"></i>
            <h2>Pompiste</h2>
            <div class="btn-choice">S'inscrire en tant que Pompiste</div>
        </a>
    </div>

{% endblock %}
