<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Profil Client - Carburant</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-gray-100">

  <!-- HEADER PROFIL -->
  <header class="bg-white shadow-md">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
      
      <div class="flex items-center gap-4">
        <img 
          src="https://images.unsplash.com/photo-1771050889377-b68415885c64?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxwcm9mZXNzaW9uYWwlMjBhdmF0YXIlMjBwb3J0cmFpdHxlbnwxfHx8fDE3NzE1ODg2MTB8MA&ixlib=rb-4.1.0&q=80&w=1080"
          class="w-16 h-16 rounded-full object-cover"
        />

        <div>
          <h1 class="text-xl font-bold">Jean Dupont</h1>
          <p class="text-sm text-gray-500">ID: CLT-2024-0542</p>
          <p class="text-sm text-gray-500">Plaque: AB-123-CD</p>
        </div>
      </div>

      <button 
        class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600"
        onclick="alert('Déconnexion...')"
      >
        Déconnexion
      </button>

    </div>
  </header>

  <!-- CONTENU PRINCIPAL -->
  <main class="max-w-7xl mx-auto p-6">

    <!-- STATUS VEHICULE -->
    <section class="bg-white rounded-2xl shadow p-6 mb-8">
      <h2 class="text-lg font-semibold mb-4">Statut du véhicule</h2>

      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-green-100 p-4 rounded-xl">
          <p class="text-sm text-gray-600">Dernier ravitaillement</p>
          <p class="text-lg font-bold">Il y a 5 jours</p>
        </div>

        <div class="bg-yellow-100 p-4 rounded-xl">
          <p class="text-sm text-gray-600">Prochain ravitaillement disponible</p>
          <p class="text-lg font-bold">Dans 2 jours</p>
        </div>
      </div>
    </section>

    <!-- HISTORIQUE -->
    <section class="bg-white rounded-2xl shadow p-6">
      <h2 class="text-lg font-semibold mb-6">Historique des ravitaillements</h2>

      <div class="space-y-4">

        <div class="border rounded-xl p-4 flex justify-between items-center">
          <div>
            <p class="font-semibold">Station Total - Avenue des Champs</p>
            <p class="text-sm text-gray-500">Diesel • 45.5L</p>
            <p class="text-sm text-gray-400">Il y a 5 jours</p>
          </div>
          <p class="font-bold text-lg">75.83 €</p>
        </div>

        <div class="border rounded-xl p-4 flex justify-between items-center">
          <div>
            <p class="font-semibold">Shell Express - Route Nationale</p>
            <p class="text-sm text-gray-500">Diesel • 38.2L</p>
            <p class="text-sm text-gray-400">08/02/2026</p>
          </div>
          <p class="font-bold text-lg">63.73 €</p>
        </div>

        <div class="border rounded-xl p-4 flex justify-between items-center">
          <div>
            <p class="font-semibold">BP Service - Centre Ville</p>
            <p class="text-sm text-gray-500">Diesel • 42.0L</p>
            <p class="text-sm text-gray-400">01/02/2026</p>
          </div>
          <p class="font-bold text-lg">70.14 €</p>
        </div>

        <div class="border rounded-xl p-4 flex justify-between items-center">
          <div>
            <p class="font-semibold">Esso - Périphérique Sud</p>
            <p class="text-sm text-gray-500">Diesel • 40.8L</p>
            <p class="text-sm text-gray-400">25/01/2026</p>
          </div>
          <p class="font-bold text-lg">68.13 €</p>
        </div>

        <div class="border rounded-xl p-4 flex justify-between items-center">
          <div>
            <p class="font-semibold">Station Total - Avenue des Champs</p>
            <p class="text-sm text-gray-500">Diesel • 44.3L</p>
            <p class="text-sm text-gray-400">18/01/2026</p>
          </div>
          <p class="font-bold text-lg">73.85 €</p>
        </div>

      </div>
    </section>

  </main>

</body>
</html>