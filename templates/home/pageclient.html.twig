<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Profil Client - {{ user.prenom }}</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-gray-100">

    <header class="bg-white shadow-md">
        <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">

            <div class="flex items-center gap-4">
                {# Génération d'un avatar avec les initiales car plus de photo #}
                <div class="w-16 h-16 rounded-full bg-indigo-600 flex items-center justify-center text-white text-xl font-bold uppercase">
                    {{ user.prenom|slice(0, 1) }}{{ user.nom|slice(0, 1) }}
                </div>

                <div>
                    <h1 class="text-xl font-bold">{{ user.prenom }} {{ user.nom }}</h1>
                    <p class="text-sm text-gray-500">ID Client : {{ user.id }}</p>
                    <p class="text-sm text-gray-500">{{ user.email }}</p>
                </div>
            </div>

            {# Lien vers la route de déconnexion configurée dans security.yaml #}
            <a href="{{ path('app_logout') }}" 
               class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600 transition-colors">
                Déconnexion
            </a>

        </div>
    </header>

    <main class="max-w-7xl mx-auto p-6">

        <section class="bg-white rounded-2xl shadow p-6 mb-8">
            <h2 class="text-lg font-semibold mb-4">Statut du compte</h2>

            <div class="grid md:grid-cols-2 gap-6">
                <div class="bg-green-100 p-4 rounded-xl">
                    <p class="text-sm text-gray-600">Total ravitaillements</p>
                    <p class="text-lg font-bold">{{ historique|length }} enregistrements</p>
                </div>

                <div class="bg-amber-100 p-4 rounded-xl">
            <p class="text-sm text-gray-600">Prochain plein autorisé</p>
            <p class="text-lg font-bold text-amber-800">
                {% if historique is not empty %}
                    {# On prend la date de la dernière essence et on ajoute 1 jour #}
                    {% set derniereDate = historique|first.date %}
                    {% set prochaineDate = derniereDate|date_modify("+24 hours") %}
                    
                    {% if "now"|date('U') >= prochaineDate|date('U') %}
                        <span class="text-green-600">Disponible maintenant ✅</span>
                    {% else %}
                        Le {{ prochaineDate|date('d/m à H:i') }}
                    {% endif %}
                {% else %}
                    <span class="text-green-600">Disponible maintenant ✅</span>
                {% endif %}
            </p>
        </div>

               
        <section class="bg-white rounded-2xl shadow p-6">
            <h2 class="text-lg font-semibold mb-6">Historique des ravitaillements</h2>

            <div class="space-y-4">
                {# On boucle sur la variable 'historique' envoyée par le contrôleur #}
                {% for essence in historique %}
                    <div class="border rounded-xl p-4 flex justify-between items-center hover:bg-gray-50 transition-colors">
                        <div>
                            {# On accède aux propriétés de ton entité EnregistrementEssence #}
                            <p class="font-semibold">{{ essence.station.nom }}</p>
                            <p class="text-sm text-gray-500">{{ essence.typeCarburant }} • {{ essence.quantite }}L</p>
                            <p class="text-sm text-gray-400">
                                Le {{ essence.date|date('d/m/Y à H:i') }}
                            </p>
                        </div>
                        <p class="font-bold text-lg text-indigo-700">{{ (essence.quantite * 2)|number_format(2, ',', ' ') }} €</p>
                    </div>
                {% else %}
                    {# Ce bloc s'affiche si la liste 'historique' est vide #}
                    <div class="text-center py-10">
                        <p class="text-gray-500">Aucun ravitaillement enregistré pour le moment.</p>
                    </div>
                {% endfor %}

            </div>
        </section>

    </main>

</body>
</html>