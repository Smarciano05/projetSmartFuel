{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}


{% block body %}
    <link rel="stylesheet" href="{{ asset('css/home.css') }}">

        <section class="section">
            <div class="section-content">

            </div>
        </section>

        <section class="section">
            <div class="section-content">
                <h1>Choisir votre profil</h1>
                <h3>SmartFuel s'adapte à vos besoins</h3>
            </div>

            <div class="profiles-container">
                <div class="container-client icon-container">
                    <i class="fa-solid fa-circle-user"></i>
                    <h4 class="title">Client</h4>
                    <ul class="profile-list">
                        <li><span class="bullet"></span> Consultez l'historique de consommation</li>
                        <li><span class="bullet"></span> Consulter la carte interactive</li>
                        <li><span class="bullet"></span> Suivez vos dépenses</li>
                        <li><span class="bullet"></span> Gérez votre profil</li>
                    </ul>
                    <button class="button-client">Accéder - client</button>
                </div>

                <div class="container-pompiste icon-container">
                    <i class="fa-solid fa-gas-pump"></i>
                    <h4 class="title">Pompiste</h4>
                    <ul class="profile-list">
                        <li><span class="bullet"></span> Enregistrez les prises d'essence</li>
                        <li><span class="bullet"></span> Consulter la carte interactive</li>
                        <li><span class="bullet"></span> Gérez votre station</li>
                        <li><span class="bullet"></span> Gérez votre profil</li>
                    </ul>
                    <button class="button-pompiste">Accéder - pompiste</button>
                </div>
            </div>
        </section>

        <section class="section">
            <div class="section-content">
                <h1> Fonctionnalités principales </h1>
                <br>
                <ul class="features-list">
                <li>
                    <i class="fa-solid fa-location-dot"></i>
                    Carte Interactive
                    <p> Localisez les stations disponibles en temps réel</p>
                </li>
                <li>

                    <p> </p>
                </li>
                <li>

                    <p></p>
                </li>
                <li>
                    Profil
                    <p>Gérez vos informations personnelles</p>
                </li>
                </ul>
            </div>
        </section>

{% endblock %}
