{% extends 'base.html.twig' %}

{% block title %}Profile pompiste{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/profilePompiste.css') }}">
{% endblock %}
{% block body %}
    <div class="app-container">
        <header class="main-header">
            <div class="header-left">
                <div class="user-block">
                    <span class="user-name">Bonjour {{NOM}} {{PRENOM}}</span>
                </div>
                <div class="separator"></div>
                <span class="station-name">Station {{NOM_station}}</span>
            </div>
            
            <div class="header-right">
                <a href="{{ path('app_logout') }}" class="logout-btn">Déconnexion</a>
            </div>
        </header>

        <div class="content-wrapper">
            <aside class="sidebar">
                <ul class="nav-menu">
                    <li>
                        <a href="{{ path('app_recherche_plaque') }}">
                            <i class="fas fa-search fa-fw"></i> Rechercher une plaque
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('app_prise_essence_index') }}">
                            <i class="fas fa-gas-pump fa-fw"></i> Enregistrer une prise de carburant
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('app_stock_carburant') }}">
                            <i class="fas fa-boxes fa-fw"></i> Gestion de stock
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('app_carte') }}">
                            <i class="fas fa-map-marker-alt fa-fw"></i> Carte des Stations
                        </a>
                    </li>
                </ul>
            </aside>

            <main class="main-content">
                {% block main %}
                    <div class="dashboard-grid">
                        <a href="{{ path('app_prise_essence_index') }}" class="menu-card">
                            <div class="icon-circle icon-green">
                                <i class="fas fa-gas-pump"></i>
                            </div>
                            <div class="card-content">
                                <h3>Enregistrer une prise</h3>
                                <p>Enregistrer une nouvelle prise d'essence</p>
                            </div>
                        </a>

                        <a href="{{ path('app_recherche_plaque') }}" class="menu-card">
                            <div class="icon-circle icon-orange"> <i class="fas fa-search"></i>
                            </div>
                            <div class="card-content">
                                <h3>Rechercher une plaque</h3>
                                <p>Vérifier l'autorisation de faire le plein</p>
                            </div>
                        </a>

                        <a href="{{ path('app_carte') }}" class="menu-card">
                            <div class="icon-circle icon-purple"> <i class="fas fa-map-marker-alt"></i>
                            </div>
                            <div class="card-content">
                                <h3>Carte des stations</h3>
                                <p>Accéder à la carte des stations</p>
                            </div>
                        </a>

                        <a href="{{ path('app_stock_carburant') }}" class="menu-card">
                            <div class="icon-circle icon-blue">
                                <i class="fas fa-boxes"></i>
                            </div>
                            <div class="card-content">
                                <h3>Gestion de Stock</h3>
                                <p>Suivi des cuves et réapprovisionnement</p>
                            </div>
                        </a>
                    </div>
                {% endblock %}
            </main>
        </div>
    </div>
{% endblock %}