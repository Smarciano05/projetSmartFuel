{#
    RÔLE : Page d'accueil du profile pompiste
    URL : /pompiste (ou route 'app_pompiste')
#}
{% extends 'baseProfilePompiste.html.twig' %}

{# TITRE DE LA PAGE - S'affiche dans l'onglet du navigateur #}
{% block title %}Profile pompiste{% endblock %}


{% block stylesheets %}
    {{ parent() }}  {# Garde le CSS global de base.html.twig (on a besoin pour le footer) et de baseProfilePompiste.html.twig #}
    <link rel="stylesheet" href="{{ asset('css/profilePompiste.css') }}">
{% endblock %}

{% block menu %} {% endblock %} {# On ne met pas le menu pour la première page sinon ça se répète les liens #}
{% block main %}
    <div class="dashboard-grid">

        {# 1er LIEN : Rechercher une plaque #}
        <a href="{{ path('app_recherche_plaque') }}" class="menu-card">
            <div class="icon-circle icon-orange"> <i class="fas fa-search"></i>
            </div>
            <div class="card-content">
                <h3>Rechercher une plaque</h3>
                <p>Vérifier l'autorisation de faire le plein</p>
            </div>
        </a>

        {# 2e LIEN : Enregistrer une prise #}
        <a href="{{ path('app_prise_essence_index') }}" class="menu-card">
            <div class="icon-circle icon-green">
                <i class="fas fa-gas-pump"></i>
            </div>
            <div class="card-content">
                <h3>Enregistrer une prise</h3>
                <p>Enregistrer une nouvelle prise d'essence</p>
            </div>
        </a>

        {# 3e LIEN : Carte des stations (VIOLETTE) #}
        <a href="{{ path('app_carte') }}" class="menu-card">
            <div class="icon-circle icon-purple"> <i class="fas fa-map-marker-alt"></i>
            </div>
            <div class="card-content">
                <h3>Carte des stations</h3>
                <p>Accéder à la carte des stations</p>
            </div>
        </a>

        {# 4e LIEN : Gestion de Stock (BLEUE) #}
        <a href="{{ path('app_stock_carburant') }}" class="menu-card">
            <div class="icon-circle icon-blue">
                <i class="fas fa-boxes"></i>
            </div>
            <div class="card-content">
                <h3>Gestion de Stock</h3>
                <p>Suivi des cuves et réapprovisionnement</p>
            </div>
        </a>
    </div>
{% endblock %}
