{# templates/about/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}À propos - SmartFuel{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/about.css') }}">
{% endblock %}

{% block main %}
<div class="about-page">
    
    {# Section hero #}
    <section class="hero-about">
        <h1>À propos de SmartFuel</h1>
        <p>La gestion de carburant simplifiée</p>
    </section>
    
    {# Section mission #}
    <section class="section-about">
        <div class="container">
            <div class="icon-box">
                <i class="fas fa-bullseye"></i>
            </div>
            <h2>Notre mission</h2>
            <p>SmartFuel a pour mission de digitaliser et simplifier la gestion des carburants pour les stations-service, tout en offrant une expérience fluide aux clients.</p>
        </div>
    </section>
    
    {# Section valeurs #}
    <section class="section-about alt">
        <div class="container">
            <div class="icon-box">
                <i class="fas fa-heart"></i>
            </div>
            <h2>Nos valeurs</h2>
            <div class="values-grid">
                <div class="value-card">
                    <i class="fas fa-shield-alt"></i>
                    <h3>Sécurité</h3>
                    <p>Transactions sécurisées et données protégées</p>
                </div>
                <div class="value-card">
                    <i class="fas fa-bolt"></i>
                    <h3>Rapidité</h3>
                    <p>Processus simplifiés et efficaces</p>
                </div>
                <div class="value-card">
                    <i class="fas fa-smile"></i>
                    <h3>Satisfaction</h3>
                    <p>Service client réactif et disponible</p>
                </div>
            </div>
        </div>
    </section>
    
    {# Section équipe #}
    <section class="section-about">
        <div class="container">
            <div class="icon-box">
                <i class="fas fa-users"></i>
            </div>
            <h2>Notre équipe</h2>
            <p>Une équipe passionnée de développeurs et d'experts du secteur carburant, dédiée à créer la meilleure solution de gestion.</p>
        </div>
    </section>
    
    {# Section contact #}
    <section class="section-about alt">
        <div class="container">
            <div class="icon-box">
                <i class="fas fa-envelope"></i>
            </div>
            <h2>Nous contacter</h2>
            <p>📧 contact@smartfuel.fr</p>
            <p>📞 +33 1 23 45 67 89</p>
            <p>📍 France</p>
        </div>
    </section>
    
</div>
{% endblock %}