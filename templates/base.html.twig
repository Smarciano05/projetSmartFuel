<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
        {% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/base.css') }}">{% endblock %}

    </head>
    <body>
    {% block body %}
            
        <header class="navbar-custom">
            <div class="header-container">
                <div class="logo-box">
                    <img src="{{ asset('images/logoSite.png') }}" alt="SmartFuel">
                </div>

                <nav class="nav-links">
                    <a href="#" class="nav-btn-link">
                        <img src="{{ asset('images/logoCarte.png') }}" alt="" class="nav-icon">
                        Carte
                    </a>
                    <a href="#" class="btn-connexion">Connexion</a>
                </nav>
            </div>
        </header>

        <main class="main-content">
            {% block main %}
                {% endblock %}
        </main>

        {% endblock %}
        <footer>
            <div class="footer-content">
                <div class="piedSite">
                    <h4 class="h4new nomContact">Contact</h4>
                    <p class="num">Tel: +33 1 23 45 67 89</p>
                    <p class="email">Email: contact@smartfuel.fr</p>
                </div>
                
                <div class="liens-utiles">
                    <h4 class="h4new">Navigation</h4>
                    <ul>
                        <li><a href="{{ path('app_home') }}">Accueil</a></li>
                        <li><a href="#">Tarifs</a></li>
                        <li><a href="#">À propos</a></li>
                    </ul>
                </div>
            </div>

            <div class="container">
                <a class="mb-0" href="#">© {{ "now"|date("Y") }} SmartFuel - Tous droits réservés.</a>
            </div>
        </footer>

        <script src="https://kit.fontawesome.com/1497a6bbb1.js" crossorigin="anonymous"></script>

    </body>
</html>
