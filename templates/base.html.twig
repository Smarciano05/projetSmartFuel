<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="{{ asset('css/base.css') }}">
        {% block stylesheets %}
        {% endblock %}

    </head>
    <body>
        <div class="en_tete">

            <img class="logoSite" src="/images/logoSite.png" alt="image_du_logo" height="60px" width="170px">

            <button class="btn buttonAccueil"> Accueil </button>
            <button class="btn buttonCarte" ><img src="/images/logoCarte.png"> Carte </button>
            <button class="btn buttonRecherche" ><img src="/images/logoRecherche.png"> Recherche </button>
            <button class="btn buttonConnexion"> Connexion </button>

        </div>
        {% block body %}{% endblock %}

       
        <footer>
            <div class="piedSite">
                <h4 class="nomContact"> Contact </h4>
                <p class="num"> Tel: +33 1 23 45 67 89</p>
            </div>
            <div class="container">
                <a class="mb-0" href="#">© {{ "now"|date("Y") }} SmartFuel - Tous droits réservés.</a>
            </div>
        </footer>

        <script src="https://kit.fontawesome.com/1497a6bbb1.js" crossorigin="anonymous"></script>

    </body>
</html>
