<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/base.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
<!-- HEADER FIXE -->
<div class="en_tete">
    <a href="/"><img class="logoSite" src="/images/logoSite.png" alt="Logo SmartFuel" height="60" width="170"></a>
    <a href="/" class="btn buttonAccueil">Accueil</a>
    <a href="/carte" class="btn buttonCarte"><img src="/images/logoCarte.png" alt="Logo Carte">Carte</a>
    <a href="#" class="btn buttonRecherche"><img src="/images/logoRecherche.png" alt="Logo Recherche">Recherche</a>
    <a href="#" class="btn buttonConnexion">Connexion</a>
</div>

<!-- WRAPPER POUR CENTRER LE CONTENU -->
<div class="wrapper">
    <div class="container-fluid d-flex flex-column">
        {% block body %}{% endblock %}
    </div>
</div>

<!-- FOOTER -->
<footer>
    <div class="piedSite">
        <h4 class="nomContact">Contact</h4>
        <p class="num">Tel: +33 1 23 45 67 89</p>
    </div>
    <div class="container">
        <a class="mb-0" href="#">© {{ "now"|date("Y") }} SmartFuel - Tous droits réservés.</a>
    </div>
</footer>

<script src="https://kit.fontawesome.com/1497a6bbb1.js" crossorigin="anonymous"></script>
</body>
</html>
