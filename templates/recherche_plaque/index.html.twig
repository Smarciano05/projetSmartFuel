{% extends 'baseProfilePompiste.html.twig' %}

{% block stylesheets %}
    {{ parent() }}  {# Garde le CSS global de base.html.twig (on en a besoin pour le footer) #}
    <link rel="stylesheet" href="{{ asset('css/recherche_plaque.css') }}">
{% endblock %}

{% block main %}
<div class="search-container">
    <h1>Recherche par Immatriculation</h1>

    <form method="get" class="search-form">
        <input type="text" name="q" value="{{ plaque_recherchee }}" placeholder="Ex: AA-123-AA">
        <button type="submit">Chercher</button>
    </form>
</div>
<div class="max-w-4xl mx-auto p-6">
    {% if plaque_recherchee %}
        <div class="mb-6 p-4 rounded-xl {{ peut_ravitailler ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' }} font-bold">
            {% if peut_ravitailler %}
                ✅ Ravitaillement AUTORISÉ pour la plaque {{ plaque_recherchee }}
            {% else %}
                ❌ Ravitaillement INTERDIT : Moins de 24h depuis le dernier plein.
            {% endif %}
        </div>

        <div class="bg-white shadow rounded-2xl overflow-hidden">
            <table class="w-full text-left">
                <thead class="bg-gray-50 border-b">
                    <tr>
                        <th class="p-4">Date</th>
                        <th class="p-4">Station</th>
                        <th class="p-4">Quantité</th>
                        <th class="p-4">Statut 24h</th>
                    </tr>
                </thead>
                <tbody>
                    {% for essence in resultats %}
                        <tr class="border-b hover:bg-gray-50">
                            <td class="p-4">{{ essence.date|date('d/m/Y H:i') }}</td>
                            <td class="p-4">{{ essence.station.nom }}</td>
                            <td class="p-4">{{ essence.quantite }}L</td>
                            <td class="p-4 text-sm">
                                {% set diff = date().diff(essence.date) %}
                                {% if diff.days < 1 %}
                                    <span class="text-red-500 font-medium">Il y a {{ (date().getTimestamp() - essence.date.getTimestamp()) // 3600 }}h</span>
                                {% else %}
                                    <span class="text-green-600 font-medium">+ de 24h</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" class="p-10 text-center text-gray-500">Aucun historique pour cette plaque.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}