{% extends 'base.html.twig' %}

{% block title %}Carte {% endblock %}

{% block main %}
    <!-- CSS principal pour la carte -->
    <link rel="stylesheet" href="{{ asset('css/carte/carte.css') }}">

    <!-- Conteneur de la carte -->
    <div class="map-container">
        <!-- Header avec titre et sous-titre -->
        <div class="map-header">
            <h1>Carte des stations</h1>
            <p>Visualisez les stations d'essence disponibles</p>
        </div>

        <!-- Cette div contient la carte -->
        <!-- C'est le conteneur où Leaflet va dessiner la carte -->
        <!-- On ne met rien dedans car Leaflet injecte la carte dynamiquement -->
        <div id="map"></div>
    </div>

    <!-- Bibliothèques Leaflet et MarkerCluster -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.3.1/dist/leaflet.css"
          integrity="sha512-Rksm5RenBEKSKFjgI3a41vrjkw4EVPlJ3+OiI65vTjIdo9brlAacEuKOiQ5OFh7cOI1bkDwLqdLw3Zg0cRJAAQ=="
          crossorigin=""/>
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.3.0/dist/MarkerCluster.css"/>
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.3.0/dist/MarkerCluster.Default.css"/>

    <script src="https://unpkg.com/leaflet@1.3.1/dist/leaflet.js"
            integrity="sha512-/Nsx9X4HebavoBvEBuyp3I7od5tA0UzAxs+j83KgC8PU0kgB4XiK4Lfe4y4cgBtaRJQEIFCW+oC506aPT2L1zw=="
            crossorigin=""></script>
    <script src="https://unpkg.com/leaflet.markercluster@1.3.0/dist/leaflet.markercluster.js"></script>

    <script type="text/javascript">
        // Coordonnées de la capitale du Mali : Bamako
        var lat = 12.6392;
        var lon = -8.0029;
        var macarte = null;
        var markerClusters;

        // Icone custom pour les markers
        var icone = L.icon({
            iconUrl: "{{ asset('images/station-essence(5).png') }}",
            iconSize: [60, 60],
            iconAnchor: [25, 50],
            popupAnchor: [0, -50]
        })

        // Fonction pour initialiser la carte
        function initMap() {
            // Création de la carte centrée sur Bamako
            macarte = L.map('map').setView([lat, lon], 11);
            markerClusters = L.markerClusterGroup();

            // Fond de carte OpenStreetMap
            L.tileLayer('https://{s}.tile.openstreetmap.fr/osmfr/{z}/{x}/{y}.png', {
                attribution: 'données © <a href="//osm.org/copyright">OpenStreetMap</a>/ODbL - rendu <a href="//openstreetmap.fr">OSM France</a>',
                minZoom: 1,
                maxZoom: 20
            }).addTo(macarte);

            // Récupération du fichier GeoJSON contenant les stations d'essence
            // Converti ensuite en JSON pour pouvoir créer les markers
            fetch('data/stationEssence.geojson').then(function (response){
                return response.json();
            }).then(function (data){
                // L.geoJSON(data) parcourt le fichier et crée un marker pour chaque station
                L.geoJSON(data, {
                    pointToLayer: function (feature, latlng) {
                        var marker =  L.marker(latlng, {icon: icone});
                        var properties = feature.properties;

                        // Popup pour chaque station
                        marker.bindPopup('<div style="font-size: 16px;"><strong>' + " Nom : " + properties.name + '</strong></div>');
                        return marker;
                    }
                }).addTo(markerClusters);

                // Ajout des clusters sur la carte
                macarte.addLayer(markerClusters);
            }).catch(function (error){
                console.log('Erreur lors du chargement du fichier GeoJSON :', error);
            });
        }

        // Initialisation de la carte au chargement de la page
        window.onload = function () {
            initMap();
        };
    </script>

{% endblock %}
