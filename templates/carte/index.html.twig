{% extends 'base.html.twig' %}

{% block title %}Carte{% endblock %}

{% block main %}
    <link rel="stylesheet" href="{{ asset('css/carte/carte.css') }}">

    <div class="map-container">
        <div class="map-header">
            <h1>Carte des stations</h1>
            <p>Visualisez les stations d'essence disponibles</p>
        </div>

        <div id="map"></div>
    </div>

    <!-- Import des bibliothèques CSS pour Leaflet et MarkerCluster -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.3.1/dist/leaflet.css"
          integrity="sha512-Rksm5RenBEKSKFjgI3a41vrjkw4EVPlJ3+OiI65vTjIdo9brlAacEuKOiQ5OFh7cOI1bkDwLqdLw3Zg0cRJAAQ=="
          crossorigin=""/>
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.3.0/dist/MarkerCluster.css"/>
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.3.0/dist/MarkerCluster.Default.css"/>

    <!-- Import des bibliothèques JavaScript pour Leaflet et MarkerCluster -->
    <script src="https://unpkg.com/leaflet@1.3.1/dist/leaflet.js"
            integrity="sha512-/Nsx9X4HebavoBvEBuyp3I7od5tA0UzAxs+j83KgC8PU0kgB4XiK4Lfe4y4cgBtaRJQEIFCW+oC506aPT2L1zw=="
            crossorigin=""></script>
    <script src="https://unpkg.com/leaflet.markercluster@1.3.0/dist/leaflet.markercluster.js"></script>

    <script type="text/javascript">
        // Coordonnées par défaut pour centrer la carte sur Bamako (Mali)
        var lat = 12.6392;
        var lon = -8.0029;
        var macarte = null; // Variable pour stocker l'instance de la carte
        var markerClusters; // Variable pour stocker les clusters de marqueurs

        var icone = L.icon({
            iconUrl: "{{ asset('images/station-essence(5).png') }}",
            iconSize: [60, 60],
            iconAnchor: [25, 50],
            popupAnchor: [0, -50]
        });

        // Fonction pour initialiser la carte
        function initMap() {
            // Création de la carte centrée sur les coordonnées de Bamako
            macarte = L.map('map').setView([lat, lon], 11);

            // debug uniquement ( centrer sur station : star)
            //macarte.setView([12.6547626, -7.9757077], 16);

            //  groupe de clusters pour regrouper les marqueurs proches
            markerClusters = L.markerClusterGroup();

            // Ajout du fond de carte OpenStreetMap
            L.tileLayer('https://{s}.tile.openstreetmap.fr/osmfr/{z}/{x}/{y}.png', {
                attribution: 'données © <a href="//osm.org/copyright">OpenStreetMap</a>/ODbL - rendu <a href="//openstreetmap.fr">OSM France</a>',
                minZoom: 1,
                maxZoom: 20
            }).addTo(macarte);

            // api/carte de carteController qui recupere les données de l'API (fichier geojson)
            fetch('api/carte')
                .then(function(response) {
                    return response.json();
                }).then(data => {

                // Création des marqueurs pour les stations filtrées
                L.geoJSON(data, {
                    pointToLayer: function(feature, latlng) {
                        var marker = L.marker(latlng, {icon: icone});
                        var properties = feature.properties;

                        // Limite l'affichage à 3 carburants maximum dans la popup
                        var carburantsLimites = properties.carburants ? properties.carburants.slice(0, 3) : [];

                        // creer du contenu de la popup pour le marqueur
                        marker.bindPopup(
                            '<div style="font-size: 14px; padding: 5px;">' +
                            '<strong>' + properties.name + '</strong><br>' +
                            '<hr style="margin: 5px 0; border: 1px solid #ccc;">' +
                            '<strong>Carburants disponibles :</strong><br>' +
                            (carburantsLimites.length > 0 ?
                                    '<ul style="margin: 5px 0 0 15px; padding: 0;">' +
                                    carburantsLimites.map(carburant =>
                                        '<li style="margin-bottom: 3px;">' + carburant + '</li>'
                                    ).join('') +
                                    '</ul>' :
                                    'Aucun carburant disponible'
                            ) +
                            '</div>'
                        );
                        return marker;
                    }
                }).addTo(markerClusters);


                macarte.addLayer(markerClusters);

            })
                .catch(function(error) {
                    console.error('Erreur lors du chargement du fichier GeoJSON :', error);
                });
        }

        window.onload = function () {
            initMap();
        };
    </script>

{% endblock %}
