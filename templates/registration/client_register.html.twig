{#
    TEMPLATE : Formulaire d'inscription client
    RÔLE : Permettre à un nouveau client de créer un compte
    URL : /client/register
    FONCTIONNEMENT : 
        - GET  → Affiche le formulaire vide
        - POST → Envoie les données pour inscription
#}
{% extends 'base.html.twig' %}

{% block title %}Inscription Client{% endblock %}
{% block stylesheets %}{{ parent() }} <link rel="stylesheet" href="{{ asset('css/inscriptionClient.css') }}"> {% endblock %}
{% block main %}
<div class="tout">
    <div class="container">
        <div class="card">
            <div class="card-header">
                <h3>Inscription Client</h3>
            </div>
            <div class="card-body">
                
                {# Messages flash : succès de l'inscription #}
                {% for flash_success in app.flashes('success') %}
                    <div class="alert alert-success" role="alert">{{ flash_success }}</div>
                {% endfor %}

                {# Erreurs globales du formulaire #}
                {{ form_errors(registrationForm) }}


                {# Début du formulaire #}
                {{ form_start(registrationForm) }}
                    
                    {# Champ : Nom #}
                    {{ form_row(registrationForm.nom, {
                        label: 'Nom',
                        attr: {'placeholder': 'votre nom de famille'}
                    }) }}    
                    
                    {# Champ : Prénom #}
                    {{ form_row(registrationForm.prenom, {
                        label: 'Prénom',
                        attr: {'placeholder': 'votre prenom'}
                    }) }}
                
                    {# Champ : Email #}
                    {{ form_row(registrationForm.email, {
                        label: 'Email',
                        attr: {'placeholder': 'client@smartfuel.fr'}
                    }) }}

                    {# Champ : Téléphone #}
                    {{ form_row(registrationForm.numero, {
                        label: 'Numéro de téléphone',
                        attr: {'placeholder': '06 12 34 56 78'}
                    }) }}
                    
                    {# Champ : Mot de passe #}
                    {{ form_row(registrationForm.plainPassword, {
                        label: 'Mot de passe'
                    }) }}
    
                    {# Champ : Acceptation des conditions #}
                    {{ form_row(registrationForm.agreeTerms, {
                        label: 'J\'accepte les conditions d\'utilisation'
                    }) }}
                    
                    {# Bouton d'envoi #}
                    <button type="submit" class="btn btn-primary w-100 mt-3">S'inscrire</button>
                {{ form_end(registrationForm) }}
                        
                {# Lien vers connexion pour les déjà inscrits #}
                <div class="mt-4 text-center">
                    <p>Déjà inscrit ? <a href="{{path('app_client_login')}}" style="color: #22c55e; font-weight: bold; text-decoration: none;">Se connecter</a></p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}