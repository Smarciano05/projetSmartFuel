{% extends 'base.html.twig' %}

{% block title %}Connexion Pompiste{% endblock %}

{% block main %}
    <form method="post">
        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

            {# Message si l'utilisateur est déjà connecté #}
            {% if app.user %}
                <div class="mb-3">
                    Vous êtes connecté en tant que {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Déconnexion</a>
                </div>
            {% endif %}

            <form method="post">
                {# Champ Email #}
                <div class="form-row-container">
                    <label for="inputEmail" class="form-label-custom">Email</label>
                    <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-input-custom" autocomplete="email" placeholder="pompiste@smartfuel.fr" required autofocus>
                </div>

                {# Champ Mot de passe #}
                <div class="form-row-container">
                    <label for="inputPassword" class="form-label-custom">Mot de passe</label>
                    <input type="password" name="password" id="inputPassword" class="form-input-custom" autocomplete="current-password" required>
                </div>

                {# Token CSRF pour la sécurité #}
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                {# Bouton de soumission #}
                <button type="submit" class="btn-submit-pompiste">Se connecter</button>

                {# Lien vers l'inscription #}
                <div class="form-footer" style="margin-top: 1.5rem; text-align: center; font-size: 0.9rem;">
                    <p>Pas encore de compte ? 
                        <a href="{{ path('inscription_pompiste') }}" style="color: #2563eb; text-decoration: underline; font-weight: bold;">
                            Inscrivez-vous ici
                        </a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}