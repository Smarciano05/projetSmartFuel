{% extends 'base.html.twig' %}

{% block title %}Connexion Client{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/registration.css') }}">
{% endblock %}

{% block main %}
{# 1. Wrapper principal pour centrer et mettre le dégradé #}
<div class="inscription-pompiste-wrapper">
    
    {# 2. La carte qui contient tout #}
    <div class="inscription-card">
        
        {# 3. L'en-tête vert SmartFuel #}
        <div class="inscription-header">
            <h1 class="inscription-title">Conexion Client</h1>
        </div>

        {# 4. Le corps du formulaire #}
        <div class="inscription-body">
            
            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {% if app.user %}
                <div class="mb-3" style="text-align: center; color: #22c55e; font-weight: bold;">
                    Vous êtes connecté en tant que {{ app.user.userIdentifier }}<br>
                    <a href="{{ path('app_client_ logout') }}" style="color: #ff4d4d;">Déconnexion</a>
                </div>
            {% endif %}

            <form method="post">
                <div class="form-row-container">
                    <label for="inputEmail" class="form-label-custom">Email</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="inputEmail" class="form-input-custom" autocomplete="email" placeholder="client@smartfuel.fr" required autofocus>
                </div>

                <div class="form-row-container">
                    <label for="inputPassword" class="form-label-custom">Mot de passe</label>
                    <input type="password" name="_password" id="inputPassword" class="form-input-custom" autocomplete="current-password" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="btn-submit-pompiste">Se connecter</button>

                <div class="form-footer" style="margin-top: 1.5rem; text-align: center; font-size: 0.9rem;">
                    <p>Pas encore de compte ? 
                        <a href="{{ path('inscription_client') }}" style="color: #22c55e; text-decoration: underline; font-weight: bold;">
                            Inscrivez-vous ici
                        </a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}